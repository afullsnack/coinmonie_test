{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "coinmonie-dashboard",
	"main": ".output/server/index.mjs",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"keep_vars": true,
	"vars": {
		"BETTER_AUTH_TRUSTED_ORIGINS": "https://coinmonie-dashboard.miraclef60.workers.dev",
		"BETTER_AUTH_URL": "https://coinmonie-dashboard.miraclef60.workers.dev",
		"NODE_ENV": "production",
		"PLUNK_API_URL": "https://next-api.useplunk.com"
	},
	"assets": {
		"directory": ".output/public"
	}
}
