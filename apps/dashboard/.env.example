# Copy to `.env.local` and fill in. Validated by `src/env.ts`.

# --- App -------------------------------------------------------------------
# Public origin of the app (optional; used by some server utilities).
SERVER_URL=http://localhost:3000
# Browser-visible title (VITE_ vars are bundled into client code — never put secrets here).
VITE_APP_TITLE=CoinMonie

# --- Database (libSQL / SQLite) ---------------------------------------------
# Local file for development; a `libsql://…` URL for Turso in production.
DATABASE_URL=file:./local.db
# Only needed for remote libSQL (Turso).
DATABASE_AUTH_TOKEN=

# --- better-auth -------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 32
# Wrap in single quotes if it contains spaces, `#` or `$`.
BETTER_AUTH_SECRET=
# Base URL the auth API is served from (also the passkey relying-party origin).
BETTER_AUTH_URL=http://localhost:3000
# Extra comma-separated origins allowed to call the auth API, e.g. another dev port.
BETTER_AUTH_TRUSTED_ORIGINS=

# --- Email (Plunk) -----------------------------------------------------------
# Secret key (`sk_…`) from Plunk → Settings → API keys. When empty, emails are
# printed to the server console in development and sending fails in production.
PLUNK_SECRET_KEY=
# Override only for self-hosted Plunk.
PLUNK_API_URL=https://next-api.useplunk.com
# Must be an address on a domain verified in Plunk.
EMAIL_FROM=no-reply@coinmonie.com
EMAIL_FROM_NAME=CoinMonie
